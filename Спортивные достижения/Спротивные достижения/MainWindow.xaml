<Window x:Class="Спротивные_достижения.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения"
        mc:Ignorable="d"
         Title="Авторизация" 
        Height="700" 
        Width="600" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Height="120"
                CornerRadius="0,0,20,20">
            <TextBlock Text="Вход в личный кабинет" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" 
              Margin="50,60,50,0"
              VerticalAlignment="Top">

            <Border Background="White" 
                    Width="450"
                    HorizontalAlignment="Center"
                    Padding="30,25,30,25"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Авторизация" 
                               FontSize="24" 
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- Поле Логин -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Логин" 
                                   FontSize="14" 
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLogin" 
                                 FontSize="14"
                                 Padding="10,8"
                                 Height="40"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Поле Пароль -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Пароль" 
                                   FontSize="14" 
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="txtPassword" 
                                         Grid.Column="0"
                                         FontSize="14"
                                         Padding="10,8"
                                         Height="40"
                                         Background="White"
                                         Foreground="Black"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtVisiblePassword" 
                                     Grid.Column="0"
                                     FontSize="14"
                                     Padding="10,8"
                                     Height="40"
                                     Background="White"
                                     Foreground="Black"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"/>
                            <Button x:Name="btnTogglePassword" 
                                    Grid.Column="1"
                                    Content="👁"
                                    Width="40"
                                    Height="40"
                                    Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="16"
                                    Click="BtnTogglePassword_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Кнопка входа -->
                    <Button x:Name="btnLogin" 
                            Grid.Row="3"
                            Content="ВОЙТИ" 
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="16"
                            Height="45"
                            Margin="0,0,0,15"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLogin_Click"/>

                    <!-- Кнопка забыли пароль -->
                    <Button x:Name="btnForgotPassword" 
                            Grid.Row="4"
                            Content="Забыли пароль?" 
                            Background="Transparent"
                            Foreground="#2196F3"
                            FontSize="12"
                            Height="30"
                            Margin="0,0,0,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnForgotPassword_Click"/>
                    <Button x:Name="btnAftor" 
                            Grid.Row="5"
                            Content="О авторе" 
                            Background="Transparent"
                            Foreground="#2196F3"
                            FontSize="12"
                            Height="30"
                            Margin="0,0,0,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnAftor_Click"/>
                    <!-- Статус -->
                    <TextBlock x:Name="txtStatus" 
                               Grid.Row="6"
                               Text="" 
                               FontSize="12"
                               Foreground="#FF5252"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
