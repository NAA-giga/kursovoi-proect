<Window x:Class="Спротивные_достижения.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views"
        mc:Ignorable="d"
        Title="Просмотр изображения" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Height="50"
                MouseLeftButtonDown="TopPanel_MouseLeftButtonDown">
            <Grid Margin="15,0">
                <TextBlock x:Name="txtTitle" 
                           Text="Изображение достижения" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" 
                            Content="─" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Width="30"
                            Height="30"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton" 
                            Content="✕" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Width="30"
                            Height="30"
                            Margin="5,0,0,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область для изображения с ScrollViewer -->
        <ScrollViewer x:Name="ImageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      MouseLeftButtonDown="ImageArea_MouseLeftButtonDown"
                      MouseMove="ImageArea_MouseMove"
                      MouseLeftButtonUp="ImageArea_MouseLeftButtonUp">
            <Image x:Name="ImageView" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" 
                Background="#2C3E50" 
                Height="40">
            <Grid Margin="15,0">
                <TextBlock x:Name="txtStatus" 
                           Text="" 
                           Foreground="#95A5A6"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">
                    <Button x:Name="ZoomInButton" 
                            Content="Увеличить" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            BorderThickness="1"
                            BorderBrush="#95A5A6"
                            Cursor="Hand"
                            Click="ZoomInButton_Click"/>
                    <Button x:Name="ZoomOutButton" 
                            Content="Уменьшить" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            BorderThickness="1"
                            BorderBrush="#95A5A6"
                            Cursor="Hand"
                            Click="ZoomOutButton_Click"/>
                    <Button x:Name="ResetZoomButton" 
                            Content="Сброс" 
                            Background="Transparent"
                            Foreground="White"
                            FontSize="12"
                            Padding="10,5"
                            BorderThickness="1"
                            BorderBrush="#95A5A6"
                            Cursor="Hand"
                            Click="ResetZoomButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
