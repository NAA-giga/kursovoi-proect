<Window x:Class="Спротивные_достижения.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views"
        mc:Ignorable="d"
        Title="Личный кабинет администратора" 
        Height="800" 
        Width="1400" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
        Background="#FF9800" 
        Height="80"
        CornerRadius="0,0,20,20">
            <Grid Margin="20,0">
                <TextBlock Text="Личный кабинет администратора" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"/>

                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserName" 
                       Foreground="White" 
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
                    <Button x:Name="btnChangePassword" 
                    Content="Смена пароля" 
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="1"
                    BorderBrush="White"
                    FontSize="13"
                    Padding="10,5"
                    Margin="0,0,15,0"
                    Cursor="Hand"
                    Click="BtnChangePassword_Click"/>
                    <Button x:Name="btnLogout" 
                    Content="Выйти" 
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="1"
                    BorderBrush="White"
                    FontSize="14"
                    Padding="10,5"
                    Cursor="Hand"
                    Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель управления -->
            <Border Grid.Row="0" 
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Выбор пользователей:" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <ComboBox x:Name="cmbUserType" 
                              Grid.Column="1"
                              Width="180"
                              Height="32"
                              FontSize="13"
                              SelectionChanged="CmbUserType_SelectionChanged">
                        <ComboBoxItem Content="Студенты" IsSelected="True"/>
                        <ComboBoxItem Content="Классные руководители"/>
                    </ComboBox>

                    <TextBlock x:Name="txtRecordCount" 
                               Grid.Column="3"
                               Text="Всего: 0" 
                               FontSize="12"
                               Foreground="#666666"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Панель с кнопками -->
            <Border Grid.Row="1" 
        Background="White" 
        CornerRadius="8"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        Padding="15"
        Margin="20,0,20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnCreate" 
                Content="Создать пользователя" 
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="155"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnCreate_Click"/>
                    <Button x:Name="btnEdit" 
                Content="Редактировать пользователя" 
                Background="#2196F3"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="196"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnEdit_Click"/>
                    <Button x:Name="btnDelete" 
                Content="Удалить пользователя" 
                Background="#F44336"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="150"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnDelete_Click"/>
                    <Button x:Name="btnDeleteGroup" 
                Content="Удалить группу" 
                Background="#F44336"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="140"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnDeleteGroup_Click"/>
                    <Button x:Name="btnViewAchievements" 
                Content="Просмотр достижений" 
                Background="#9C27B0"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="160"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnViewAchievements_Click"/>
                    <Button x:Name="btnGenerateReport" 
                Content="Сформировать отчет" 
                Background="#FF9800"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="160"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnGenerateReport_Click"/>
                    <Button x:Name="btnImportStudents" 
                Content="Импорт списка студентов" 
                Background="#00BCD4"
                Foreground="White"
                FontWeight="Bold"
                FontSize="13"
                Height="38"
                Width="180"
                Cursor="Hand"
                Click="BtnImportStudents_Click"/>
                </StackPanel>
            </Border>
            <!-- Таблица пользователей -->
            <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="0"
                Margin="20,0,20,15">
                <ScrollViewer x:Name="UsersScrollViewer"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          PreviewMouseWheel="UsersScrollViewer_PreviewMouseWheel">
                    <ListView x:Name="lvUsers" 
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          AlternationCount="2"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.PanningMode="Both"
                          SelectionChanged="LvUsers_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding LastName}" Width="100"/>
                                <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding FirstName}" Width="100"/>
                                <GridViewColumn Header="Отчество" DisplayMemberBinding="{Binding MiddleName}" Width="100"/>
                                <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="120"/>
                                <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="180"/>
                                <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding Phone}" Width="110"/>
                                <GridViewColumn Header="Группа" DisplayMemberBinding="{Binding Group}" Width="100"/>
                                <GridViewColumn Header="Специальность" DisplayMemberBinding="{Binding Specialty}" Width="150"/>
                                <GridViewColumn Header="Курс" DisplayMemberBinding="{Binding Course}" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Course}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Дата зачисления" DisplayMemberBinding="{Binding EnrollmentDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F9F9F9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="4" 
                Background="#E0E0E0" 
                Height="40"
                CornerRadius="20,20,0,0">
            <TextBlock Text="© Система учета спортивных достижений" 
                       Foreground="#666666"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
