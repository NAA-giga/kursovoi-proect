<Window x:Class="Спротивные_достижения.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views"
        mc:Ignorable="d"
        Title="Восстановление пароля" 
        Height="650" 
        Width="600" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#FF9800" 
                Height="100"
                CornerRadius="0,0,20,20">
            <TextBlock Text="Восстановление пароля" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="50">
            <Border Background="White" 
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30">

                <StackPanel>
                    <!-- Заголовок -->
                    <TextBlock Text="Сброс пароля" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- Поле Логин -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Введите логин" 
                                   FontSize="14" 
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLogin" 
                                 FontSize="14"
                                 Padding="10"
                                 Height="40"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Поле Email -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Введите почту, на которую отправим новый пароль" 
                                   FontSize="14" 
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" 
                                 FontSize="14"
                                 Padding="10"
                                 Height="40"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Кнопка получения пароля -->
                    <Button x:Name="btnResetPassword" 
                            Content="ПОЛУЧИТЬ НОВЫЙ ПАРОЛЬ" 
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Height="45"
                            Margin="0,0,0,15"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnResetPassword_Click"/>
                    <Button x:Name="btnBack" 
                            Content="← Вернуться к авторизации" 
                            Background="Transparent"
                            Foreground="#2196F3"
                            FontSize="12"
                            Height="30"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnBack_Click"/>

                    <!-- Статус сообщение -->
                    <TextBlock x:Name="txtStatus" 
                               Text="" 
                               FontSize="12"
                               Foreground="#FF5252"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>

                    <!-- Кнопка назад -->
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
