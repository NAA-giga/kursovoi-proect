<Window x:Class="Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания.CreateTeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания"
        mc:Ignorable="d"
       Title="Создание преподавателя" 
        Height="950" 
        Width="550" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF9800" Height="80" CornerRadius="0,0,20,20">
            <TextBlock Text="Создание преподавателя" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" 
                    BorderThickness="1" Padding="25" Margin="20">
                <StackPanel>
                    <TextBlock Text="Информация о преподавателе" FontSize="18" 
                               FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Фамилия *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="LastNameTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Имя *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="FirstNameTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Отчество" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="MiddleNameTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Логин *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Пароль *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Email *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Телефон *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="PhoneTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Кафедра *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DepartmentComboBox" Height="32" 
                                  DisplayMemberPath="Название_кафедры" SelectedValuePath="ID_Кафедра"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Закрепленная группа *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Button Grid.Column="1" x:Name="CreateGroupButton" 
                                    Content="Создать группу" 
                                    Background="#2196F3" Foreground="White"
                                    FontSize="11" FontWeight="Bold"
                                    Width="100" Height="28"
                                    Cursor="Hand"
                                    Click="CreateGroupButton_Click"/>
                        </Grid>
                        <ComboBox x:Name="GroupComboBox" Height="32" 
                                  DisplayMemberPath="Название" SelectedValuePath="ID_Группа"
                                  Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="SaveButton" Content="Создать" 
                                Background="#FF9800" Foreground="White" FontWeight="Bold"
                                Width="120" Height="38" Margin="0,0,10,0" Cursor="Hand"
                                Click="SaveButton_Click"/>
                        <Button x:Name="CancelButton" Content="Отмена" 
                                Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                                Width="120" Height="38" Cursor="Hand"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12" Foreground="Red"
                               HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
