<Window x:Class="Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания.EditAchievementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания"
        mc:Ignorable="d"
        Title="Редактирование достижения" 
        Height="1000" 
        Width="550" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" Height="80" CornerRadius="0,0,20,20">
            <TextBlock Text="Редактирование достижения" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" 
                    BorderThickness="1" Padding="25" Margin="20">
                <StackPanel>
                    <TextBlock Text="Информация о достижении" FontSize="18" 
                               FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="ID достижения" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="IdTextBox" Height="32" Padding="5" IsEnabled="False" Background="#F0F0F0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Название мероприятия *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EventNameTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Вид спорта *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="SportTypeTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Уровень соревнования *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="LevelComboBox" Height="32">
                            <ComboBoxItem Content="Университетский"/>
                            <ComboBoxItem Content="Городской"/>
                            <ComboBoxItem Content="Региональный"/>
                            <ComboBoxItem Content="Всероссийский"/>
                            <ComboBoxItem Content="Международный"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Занятое место *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="PlaceTextBox" Height="32" Padding="5" MaxLength="2"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Место проведения *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="VenueTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Дата проведения *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="EventDatePicker" Height="32"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Дата выдачи *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="IssueDatePicker" Height="32"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <CheckBox x:Name="IsTeamCheckBox" Content="Командная игра" FontSize="13" 
                                  Checked="IsTeamCheckBox_Checked" Unchecked="IsTeamCheckBox_Unchecked"/>
                    </StackPanel>

                    <StackPanel x:Name="TeamSizePanel" Margin="0,0,0,20" Visibility="Collapsed">
                        <TextBlock Text="Численность команды *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TeamSizeTextBox" Height="32" Padding="5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="SaveButton" Content="Сохранить" 
                                Background="#2196F3" Foreground="White" FontWeight="Bold"
                                Width="120" Height="38" Margin="0,0,10,0" Cursor="Hand"
                                Click="SaveButton_Click"/>
                        <Button x:Name="CancelButton" Content="Отмена" 
                                Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                                Width="120" Height="38" Cursor="Hand"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12" Foreground="Red"
                               HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
