<Window x:Class="Спротивные_достижения.Views.Окна_для_Создание___редактирвания_и_удаления.DeleteGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views.Окна_для_Создание___редактирвания_и_удаления"
        mc:Ignorable="d"
        Title="Удаление группы" 
        Height="700" 
        Width="550" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#F44336" 
                Height="80"
                CornerRadius="0,0,20,20">
            <TextBlock Text="Удаление группы" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="25"
                    Margin="20">

                <StackPanel>
                    <TextBlock Text="Удаление группы и всех связанных данных" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <Border Background="#FFF3E0" 
                            CornerRadius="5" 
                            Padding="10" 
                            Margin="0,0,0,15"
                            BorderBrush="#FFB74D"
                            BorderThickness="1">
                        <TextBlock Text="ВНИМАНИЕ! Это действие удалит:" 
                                   FontSize="13" 
                                   FontWeight="Bold"
                                   Foreground="#F44336"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="• Выбранную группу" 
                               FontSize="12" 
                               Foreground="#666666"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• Всех студентов этой группы" 
                               FontSize="12" 
                               Foreground="#666666"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• Все достижения студентов" 
                               FontSize="12" 
                               Foreground="#666666"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• Классного руководителя этой группы" 
                               FontSize="12" 
                               Foreground="#666666"
                               Margin="20,0,0,15"/>

                    <TextBlock Text="Данные будут удалены без возможности восстановления!" 
                               FontSize="11" 
                               Foreground="#F44336"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Группа -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Группа *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" Height="32" 
                                  DisplayMemberPath="Название" 
                                  SelectedValuePath="ID_Группа"
                                  SelectionChanged="GroupComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Информация о выбранной группе -->
                    <Border x:Name="GroupInfoBorder" 
                            Background="#F5F5F5" 
                            CornerRadius="5" 
                            Padding="10" 
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Информация о группе:" 
                                       FontSize="12" 
                                       FontWeight="Bold"
                                       Foreground="#333333"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtGroupName" Text="" FontSize="11" Foreground="#666666"/>
                            <TextBlock x:Name="txtStudentCount" Text="" FontSize="11" Foreground="#666666"/>
                            <TextBlock x:Name="txtTeacherName" Text="" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="DeleteButton" 
                                Content="Удалить группу" 
                                Background="#F44336"
                                Foreground="White"
                                FontWeight="Bold"
                                Width="140"
                                Height="40"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                Click="DeleteButton_Click"/>
                        <Button x:Name="CancelButton" 
                                Content="Отмена" 
                                Background="#9E9E9E"
                                Foreground="White"
                                FontWeight="Bold"
                                Width="120"
                                Height="40"
                                Cursor="Hand"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusTextBlock" 
                               Text="" 
                               FontSize="12" 
                               Foreground="Red"
                               HorizontalAlignment="Center" 
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
