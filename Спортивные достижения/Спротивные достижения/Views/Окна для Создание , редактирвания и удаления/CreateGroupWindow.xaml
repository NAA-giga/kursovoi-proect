<Window x:Class="Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views.Окна_для_Создание_и_редактирвания"
        mc:Ignorable="d"
        Title="Создание группы" 
        Height="550" 
        Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" Height="80" CornerRadius="0,0,20,20">
            <TextBlock Text="Создание группы" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" 
                BorderThickness="1" Padding="25" Margin="30">
            <StackPanel>
                <TextBlock Text="Информация о группе" FontSize="18" 
                           FontWeight="SemiBold" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Название группы *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="GroupNameTextBox" Height="35" Padding="5"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Специальность *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SpecialtyComboBox" Height="35" 
                              DisplayMemberPath="Название_специальности" 
                              SelectedValuePath="ID_Специальность"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Курс *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CourseComboBox" Height="35" 
                              DisplayMemberPath="Номер_курса" 
                              SelectedValuePath="ID_Курс"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="CreateButton" Content="Создать группу" 
                            Background="#2196F3" Foreground="White" FontWeight="Bold"
                            Width="140" Height="38" Margin="0,0,10,0" Cursor="Hand"
                            Click="CreateButton_Click"/>
                    <Button x:Name="CancelButton" Content="Отмена" 
                            Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                            Width="120" Height="38" Cursor="Hand"
                            Click="CancelButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12" Foreground="Red"
                           HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
