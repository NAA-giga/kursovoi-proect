<Window x:Class="Спротивные_достижения.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views"
        mc:Ignorable="d"
        Title="Смена пароля" 
        Height="550" 
        Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#FF9800" 
                Height="80"
                CornerRadius="0,0,20,20">
            <TextBlock Text="Смена пароля" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="30"
                Margin="30"
                VerticalAlignment="Center">

            <StackPanel>


                <!-- Старый пароль -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Введите старый пароль *" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#666666"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="OldPasswordBox" 
                                 Height="38" 
                                 Padding="10"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                </StackPanel>

                <!-- Новый пароль -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Введите новый пароль *" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#666666"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="NewPasswordBox" 
                                 Height="38" 
                                 Padding="10"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                </StackPanel>

                <!-- Подтверждение пароля -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Подтвердите новый пароль *" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="#666666"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" 
                                 Height="38" 
                                 Padding="10"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                </StackPanel>

                <!-- Кнопка смены пароля -->
                <Button x:Name="ChangePasswordButton" 
                        Content="Сменить пароль" 
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Height="45"
                        Margin="0,0,0,15"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ChangePasswordButton_Click"/>

                <!-- Статус -->
                <TextBlock x:Name="StatusTextBlock" 
                           Text="" 
                           FontSize="12"
                           Foreground="#FF5252"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
