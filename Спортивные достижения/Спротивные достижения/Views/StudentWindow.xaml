<Window x:Class="Спротивные_достижения.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Спротивные_достижения.Views"
        mc:Ignorable="d"
    Title="Личный кабинет студента" 
        Height="1000" 
        Width="1200" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Height="80"
                CornerRadius="0,0,20,20">
            <Grid Margin="20,0">
                <TextBlock Text="Личный кабинет студента" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserName" 
                               Foreground="White" 
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button x:Name="btnChangePassword" 
                            Content="Смена пароля" 
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            FontSize="13"
                            Padding="10,5"
                            Margin="0,0,15,0"
                            Cursor="Hand"
                            Click="BtnChangePassword_Click"/>
                    <Button x:Name="btnLogout" 
                            Content="Выйти" 
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            FontSize="14"
                            Padding="10,5"
                            Cursor="Hand"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Блок информации -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="15"
                Margin="20,15,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Мои достижения:" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <TextBlock x:Name="txtAchievementCount" 
                           Grid.Column="2"
                           Text="Всего: 0" 
                           FontSize="12"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Таблица достижений (ListView) -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="0"
                Margin="20,0,20,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель с кнопкой -->
                <Border Grid.Row="0" 
                        Background="#F5F5F5" 
                        Padding="10,8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <Button x:Name="btnViewImage" 
                                Content="Посмотреть графическое достижение" 
                                Background="#9C27B0"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                Height="32"
                                Width="220"
                                Cursor="Hand"
                                IsEnabled="False"
                                HorizontalAlignment="Center"
                                Click="BtnViewImage_Click"/>
                    </Grid>
                </Border>

                <!-- Таблица с прокруткой -->
                <ScrollViewer x:Name="AchievementsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="AchievementsScrollViewer_PreviewMouseWheel">
                    <ListView x:Name="lvAchievements" 
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              AlternationCount="2"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.PanningMode="Both"
                              SelectionChanged="LvAchievements_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Название мероприятия" DisplayMemberBinding="{Binding EventName}" Width="200"/>
                                <GridViewColumn Header="Вид спорта" DisplayMemberBinding="{Binding SportType}" Width="120"/>
                                <GridViewColumn Header="Уровень" DisplayMemberBinding="{Binding Level}" Width="100"/>
                                <GridViewColumn Header="Место" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Place}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Место проведения" DisplayMemberBinding="{Binding Venue}" Width="150"/>
                                <GridViewColumn Header="Дата проведения" DisplayMemberBinding="{Binding EventDate, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EventDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Дата выдачи" DisplayMemberBinding="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Командная" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsTeam}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Численность" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TeamSize}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F9F9F9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.Row="3" 
                Background="#E0E0E0" 
                Height="40"
                CornerRadius="20,20,0,0">
            <TextBlock Text="© Система учета спортивных достижений" 
                       Foreground="#666666"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
